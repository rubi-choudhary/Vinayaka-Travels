    <style>
        .faq-one .faq-one-accrodion .accrodion {
            background: #fff
        }

        .faq-one .faq-one-accrodion .accrodion-content p, .faq-one .faq-one-accrodion .accrodion-title h4 {
            color: #212121
        }

        .faq-one .faq-one-accrodion .accrodion-content ul li {
            color: #212121
        }
        /* =====================================================
   HEADER / NAV RESPONSIVE OVERRIDES
   Breakpoints: 1366 / 1200 / 1199 / 992 / 767 / 567
===================================================== */

        .main-menu__wrapper-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
        }

        .main-menu__right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .main-menu__main-menu-box .mobile-nav__toggler {
            display: none;
            font-size: 24px;
            color: var(--gizmo-black, #101a24);
            cursor: pointer;
        }

        @media (max-width: 1366px) {
            .main-menu__logo img {
                width: 200px;
            }

            .main-menu .main-menu__list > li + li,
            .stricky-header .main-menu__list > li + li {
                margin-left: 16px;
            }

            .main-menu .main-menu__list > li > a,
            .stricky-header .main-menu__list > li > a {
                font-size: 16px;
            }

            .main-menu__call-number {
                font-size: 15px;
            }
        }

        @media (max-width: 1200px) {
            .main-menu__logo img {
                width: 168px;
            }

            .main-menu .main-menu__list > li + li,
            .stricky-header .main-menu__list > li + li {
                margin-left: 10px;
            }

            .main-menu .main-menu__list > li > a,
            .stricky-header .main-menu__list > li > a {
                font-size: 14px;
            }

            .main-menu__call-number {
                font-size: 13px;
            }

            .main-menu__wrapper {
                padding-left: 16px;
                padding-right: 16px;
            }

            .main-header .main-menu__middle-box .main-menu__list {
                display: none !important;
            }

            .main-header .main-menu__main-menu-box .mobile-nav__toggler {
                display: inline-flex !important;
                align-items: center;
                justify-content: center;
                order: 2;
            }

            .main-menu__wrapper-inner {
                justify-content: space-between;
            }

            .main-menu__left {
                order: 1;
            }

            .main-menu__middle-box {
                order: 3;
                flex: 0 0 auto;
            }

            .main-menu__right {
                order: 2;
                margin-left: auto;
            }

            .main-menu__nav-sidebar-icon {
                display: none;
            }
        }

        @media (max-width: 1199.98px) {
            .main-header .main-menu__middle-box .main-menu__list {
                display: none !important;
            }

            .main-header .main-menu__main-menu-box .mobile-nav__toggler {
                display: inline-flex !important;
                align-items: center;
                justify-content: center;
                order: 2;
            }

            .main-menu__wrapper-inner {
                justify-content: space-between;
            }

            .main-menu__left {
                order: 1;
            }

            .main-menu__middle-box {
                order: 3;
                flex: 0 0 auto;
            }

            .main-menu__right {
                order: 2;
                margin-left: auto;
            }

            .main-menu__nav-sidebar-icon {
                display: none;
            }

            .main-menu__logo img {
                width: 180px;
            }

            .main-menu__wrapper {
                padding-left: 16px;
                padding-right: 16px;
            }
        }

        @media (max-width: 992px) {
            .main-menu__logo img {
                width: 160px;
            }

            .main-menu__call-content {
                display: none;
            }
        }

        @media (max-width: 767px) {
            .main-menu__top {
                display: none;
            }

            .main-menu__logo img {
                width: 150px;
            }

            .main-menu__wrapper {
                padding: 12px 0;
            }

            .main-menu__main-menu-box .mobile-nav__toggler {
                font-size: 22px;
            }

            .main-menu__call-icon {
                font-size: 20px;
            }
        }

        @media (max-width: 567px) {
            .main-menu__logo img {
                width: 130px;
            }

            .main-menu__main-menu-box .mobile-nav__toggler {
                font-size: 20px;
            }
        }

        .content-box p.widget-title,
        .form-inner p.widget-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 15px;
        }
    </style>


