    <style>
        html, body, form#form1 {
            max-width: 100%;
            overflow-x: hidden;
        }

        .site-footer {
            width: 100%;
            max-width: 100%;
            overflow: hidden;
        }

            .site-footer a,
            .site-footer p,
            .site-footer li {
                overflow-wrap: anywhere;
                word-break: break-word;
            }

        @media (max-width: 991px) {
            .site-footer .container {
                width: 100%;
                max-width: 100%;
                padding-left: 20px;
                padding-right: 20px;
            }

            .site-footer .row {
                margin-left: 0;
                margin-right: 0;
            }

            .footer-widget__links,
            .footer-widget__cases,
            .footer-widget__address,
            .footer-widget__get-in-touch {
                margin-left: 0;
                margin-right: 0;
            }

            .carousel-dot-style.owl-carousel .owl-stage-outer {
                overflow: hidden;
            }

            .team-carousel-page {
                overflow: hidden;
            }
        }

        @media (max-width: 767px) {
            .site-footer__top-inner {
                padding: 40px 0 30px;
            }

            .footer-widget__links,
            .footer-widget__cases,
            .footer-widget__address,
            .footer-widget__get-in-touch {
                margin-top: 0;
                margin-bottom: 28px;
            }

            .site-footer__bottom-inner {
                flex-direction: column;
                gap: 10px;
                text-align: center;
            }
        }

        /* Buttons — centered and contained on all breakpoints */
        .team-one__car-details-single {
            display: flex;
            flex-direction: column;
            min-height: 320px;
        }

        .team-one__car-details-btn-box {
            display: flex;
            justify-content: flex-start;
            align-items: center;
            margin-top: auto;
            width: 100%;
        }

        .team-one__car-details-btn.thm-btn {
            width: auto;
            max-width: 100%;
            padding: 10px 36px;
            white-space: nowrap;
        }

        .enjoy-one__btn-box {
            display: flex;
            justify-content: center;
            width: 100%;
        }

        .enjoy-one__btn.thm-btn {
            width: auto !important;
            max-width: 100%;
            display: inline-block;
        }

        .row.justify-content-center > [class*="col-lg-2"] {
            flex: 0 0 auto;
            width: auto;
            max-width: 100%;
        }

        @media (max-width: 1366px) {
            .team-one__car-details-title {
                font-size: 32px;
                line-height: 1.3;
            }
        }

        @media (max-width: 1199px) {
            .team-one__car-details-title {
                font-size: 28px;
                line-height: 1.3;
            }

            .team-one__car-details-single {
                min-height: 280px;
                padding: 36px 24px 32px;
            }
        }

        @media (max-width: 991px) {
            .team-one__car-details-single {
                min-height: 260px;
                text-align: center;
            }

            .team-one__car-details-title {
                font-size: 26px;
            }

            .team-one__car-details-btn-box {
                justify-content: center !important;
            }
        }

        @media (max-width: 767px) {
            .team-one__car-details-single {
                min-height: 240px;
                padding: 32px 20px 28px;
            }

            .team-one__car-details-title {
                font-size: 24px;
                line-height: 1.3;
            }

            .team-one__car-details-btn.thm-btn,
            .enjoy-one__btn.thm-btn,
            .thm-btn {
                padding: 10px 28px;
                font-size: 15px;
                line-height: 1.4;
            }
        }

        @media (max-width: 567px) {
            .team-one__car-details-single {
                min-height: 220px;
                padding: 28px 16px 24px;
            }

            .team-one__car-details-title {
                font-size: 22px;
            }

            .team-one__car-details-text {
                font-size: 14px;
            }

            .team-one__car-details-btn.thm-btn,
            .enjoy-one__btn.thm-btn,
            .thm-btn {
                padding: 10px 22px;
                font-size: 14px;
            }
        }

        /* Fleet cards — equal height, even gaps */
        .car-brands .car-brands__grid {
            display: grid !important;
        }

        .car-brands .enjoy-one__btn-box {
            margin-top: 8px;
        }

        .enjoy-one {
            overflow: visible;
        }

            .enjoy-one .container {
                max-width: 100%;
            }

        @media (min-width: 992px) {
            section.enjoy-one .row {
                align-items: center;
            }
        }

        @media (min-width: 992px) and (max-width: 1199.98px) {
            .enjoy-one__left {
                margin-right: 0 !important;
            }

            section.enjoy-one .enjoy-one__right {
                margin-left: -100px !important;
                margin-right: 0 !important;
                margin-top: 40px !important;
                max-width: none !important;
                width: calc(100% + 100px) !important;
                left: auto !important;
                transform: none !important;
            }

            .enjoy-one__title-box {
                padding: 40px 28px 36px;
            }

            .enjoy-one__title {
                font-size: 26px;
                line-height: 1.3;
                overflow-wrap: break-word;
            }

            .enjoy-one__btn-box {
                display: flex;
                justify-content: center;
            }
        }

        @media (min-width: 1200px) {
            .enjoy-one__left {
                margin-right: 0 !important;
            }

            section.enjoy-one .enjoy-one__right {
                margin-left: -160px !important;
                margin-right: 0 !important;
                margin-top: 40px !important;
                max-width: none !important;
                width: calc(100% + 160px) !important;
                left: auto !important;
            }

            .enjoy-one__title-box {
                padding: 48px 40px 44px;
            }

            .enjoy-one__title {
                font-size: 36px;
                line-height: 1.25;
            }

            .enjoy-one__btn-box {
                display: flex;
                justify-content: center;
            }
        }

        @media (max-width: 991.98px) {
            .enjoy-one__left {
                margin-right: 0 !important;
                max-width: 100%;
            }

            section.enjoy-one .enjoy-one__right {
                margin-left: 0 !important;
                margin-right: 0 !important;
                margin-top: 24px !important;
                max-width: 100% !important;
                width: 100%;
                left: 0 !important;
                transform: none !important;
            }

            section.enjoy-one .wow {
                animation: none !important;
                transform: none !important;
                visibility: visible !important;
            }

            .enjoy-one__title-box {
                padding: 32px 24px 28px;
            }

            .enjoy-one__title {
                font-size: 28px;
                line-height: 1.3;
                overflow-wrap: break-word;
            }

            .enjoy-one__btn-box {
                display: flex;
                justify-content: center;
            }
        }

        @media (max-width: 767px) {
            .enjoy-one {
                padding-left: 0;
                padding-right: 0;
            }

            .enjoy-one__right {
                margin-top: 20px !important;
            }

            .enjoy-one__title-box {
                padding: 28px 20px 24px;
            }

            .enjoy-one__title {
                font-size: 24px;
                line-height: 1.35;
            }

            .enjoy-one__text {
                margin-bottom: 20px;
            }
        }

        @media (max-width: 567px) {
            .enjoy-one__title {
                font-size: 22px;
            }

            .enjoy-one__title-box {
                padding: 24px 16px 22px;
            }
        }



        .wow h1, .wow h2, .wow h3, .wow h4, .wow h5, .wow h6 {
    visibility: visible !important;
    opacity: 1 !important;
}
    </style>
</head>
<body class="custom-cursor">
    <%--    <form id="form1" runat="server">--%>
    <form id="form1" runat="server" novalidate="novalidate">

        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true" EnablePartialRendering="false" />
        <!-- Start sidebar widget content -->
        <div class="xs-sidebar-group info-group info-sidebar">
            <div class="xs-overlay xs-bg-black"></div>
            <div class="xs-sidebar-widget">
                <div class="sidebar-widget-container">
                    <div class="widget-heading">
                        <a href="#" class="close-side-widget">X</a>
                    </div>
                    <div class="sidebar-textwidget">
                        <div class="sidebar-info-contents">
                            <div class="content-inner">
                                <div class="logo">
                                    <a href="/">
                                        <img src="/assets/images/resources/logo.png" width="300" alt="" /></a>
                                </div>
                                <%-- <div class="content-box">
                                    <h4>About Us</h4>
                                    <p>
                                        Vinayaka Travels Established in the year 2002. Company represented by people with industry experience spanning more than four decades. 
                           
                                    </p>
                                </div>--%>

                                <div class="content-box">
                                    <p class="widget-title">About Us</p>
                                    <p>
                                        Vinayaka Travels Established in the year 2002. Company represented by people with industry experience spanning more than four decades. 
                                    </p>
                                </div>
                                <div class="form-inner">
                                    <p class="widget-title">Get a free quote</p>
                                    <div action="#" class="contact-form-validated"
                                        novalidate="novalidate">
                                        <div class="form-group">
                                            <input type="text" name="name" placeholder="Name" required="">
                                        </div>
                                        <div class="form-group">
                                            <input type="email" name="email" placeholder="Email" required="">
                                        </div>
                                        <div class="form-group">
                                            <textarea name="message" placeholder="Message..."></textarea>
                                        </div>
                                        <div class="form-group message-btn">
                                            <button type="submit" class="thm-btn form-inner__btn">Submit Now</button>
                                        </div>
                                    </div>
                                    <div class="result"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- End sidebar widget content -->
        <header class="main-header">
            <div class="main-menu__top">
                <div class="main-menu__top-inner">
                    <ul class="list-unstyled main-menu__contact-list">
                        <li>
                            <div class="icon">
                                <i class="icon-pin"></i>
                            </div>
                            <div class="text">
                                <p>Jeevan Bhima Nagar, Bangalore</p>
                            </div>
                        </li>
                        <li>
                            <div class="icon">
                                <i class="icon-envelope"></i>
                            </div>
                            <div class="text">
                                <p>
                                    <a href="mailto:info@vinayakatravels.com">info@vinayakatravels.com</a>
                                </p>
                            </div>
                        </li>
                    </ul>
                    <div class="main-menu__top-right">

                        <div class="main-menu__social ">

                            <a href="#" class="d-none"><i class="icon-instagram"></i></a>
                        </div>
                    </div>
                </div>
            </div>
            <nav class="main-menu">
                <div class="main-menu__wrapper">
                    <div class="main-menu__wrapper-inner">
                        <div class="main-menu__left">
                            <div class="main-menu__logo">
                                <a href="/">
                                    <img src="/assets/images/resources/logo.png" width="300" alt=""></a>
                            </div>
                        </div>
                        <div class="main-menu__middle-box">
                            <div class="main-menu__main-menu-box">
                                <a href="#" class="mobile-nav__toggler"><i class="fa fa-bars"></i></a>
                                <ul class="main-menu__list">
                                    <li>
                                        <a href="/">Home</a>
                                    </li>

                                    <li>
                                        <a href="about.aspx">About Us</a>
                                    </li>
                                    <li>
                                        <a href="services.aspx">Services</a>
                                    </li>
                                    <li>
                                        <a href="fleets.aspx">Fleets</a>
                                    </li>
                                    <li>
                                        <a href="gallery.aspx">Gallery</a>
                                    </li>
                                    <li>
                                        <a href="booking.aspx">Book Now</a>
                                    </li>
                                    <li>
                                        <a href="contact.aspx">Contact</a>
                                    </li>

                                </ul>
                            </div>

                        </div>
                        <div class="main-menu__right">
                            <div class="main-menu__call">
                                <div class="main-menu__call-icon">
                                    <i class="icon-call"></i>
                                </div>
